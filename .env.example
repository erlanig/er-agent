# --- Wajib ---
BEDROCK_API_KEY=isi_dengan_bedrock_api_key_baru
BEDROCK_BASE_URL=https://bedrock-mantle.ap-southeast-3.api.aws/v1
APP_PASSWORD=ganti_dengan_password_kuat

# --- Opsional: ganti model ID bila berbeda di region kamu (cek GET {BASE_URL}/models) ---
# MODEL_GPT_OSS_120B=openai.gpt-oss-120b
# MODEL_GPT_OSS_20B=openai.gpt-oss-20b
# MODEL_CLAUDE_SONNET=anthropic.claude-sonnet-4-6
# MODEL_CLAUDE_HAIKU=anthropic.claude-haiku-4-5

# --- Opsional: tool CI/CD (GitHub Actions) ---
# GITHUB_TOKEN=github_pat_xxx          # fine-grained PAT: Actions (read & write) pada repo target
# GITHUB_DEFAULT_REPO=username/nama-repo
# GITHUB_ALLOWED_REPOS=username/nama-repo,username/repo-lain
